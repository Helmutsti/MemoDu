{
  "expo": {
    "name": "Memodu",
    "slug": "memodu-telefono",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mcucca.memodu",
      "appleTeamId": "5NM7586UUV",
      "icon": "../client/src-tauri/icons/macos/Memodu.icon"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Memodu usa le tue foto solo per la foto di un'entità di Brainet, quando la scegli tu.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "memodu",
    "experiments": {
      "typedRoutes": true
    }
  }
}
