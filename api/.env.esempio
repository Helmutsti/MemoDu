# Esempio di api/.env: l'utente fisso del server in locale (DEC-121).
# I valori qui sotto sono finti e non aprono niente: servono solo a mostrare il formato.
# Copia questo file in api/.env (escluso da git) e metti al posto dei valori le righe
# stampate dal comando che crea l'utente. Su Vercel le stesse righe vanno nelle
# variabili d'ambiente del progetto. Una riga per variabile, NOME=valore, senza
# virgolette e senza spazi attorno a =.

# Email con cui si accede in SC-05
MEMODU_EMAIL=manuel@esempio.it

# Sale di Argon2id: 16 byte casuali in base64url
MEMODU_SALE=6jPm3ZrvsrsQlspGwxogNA

# Parametri di Argon2id: memoria in KiB, passaggi, fili
MEMODU_ARGON2=65536,3,1

# Impronte SHA-256, in esadecimale, della prova di accesso e della prova di recupero
MEMODU_IMPRONTA_ACCESSO=71e271fbfd428c629a62158a7ce393e231e6ae56f1afc8832e7dd6021aa40036
MEMODU_IMPRONTA_RECUPERO=29396b6b4622492f31230126c91cd56af2effe57a8e9f300f60dc3814eeb7a2e

# Chiave dati avvolta con la password e con la chiave di recupero: nonce (24 byte),
# chiave cifrata (32) e controllo (16) di XChaCha20-Poly1305, in base64url
MEMODU_CHIAVE_PASSWORD=pJkTofybbW1EJxK1AC53G3k2qmNp5qtpaHnjzOuiCPrInosctfoJjUrIQPUtu-sPxE-AiMA3bgpwlO2cOrC-FvkPuxyWudOp
MEMODU_CHIAVE_RECUPERO=ZAK5In7ELtpUOI3z2vch3SL-rWLPU6oPzL5j5Gg3wAZFdy6P7zP-47dvKNT72dToHETcptVMUCCH0591EJChEm_nL4h1fzli

# Segreto che firma i JWT: 32 byte casuali in base64url. Cambiarlo fa uscire tutti i dispositivi
MEMODU_SEGRETO=qeYeaCAoPdlziWzSwopWaIa_lNPSbXu-sfuGE_0WThg
