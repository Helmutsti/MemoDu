{
  "name": "memodu",
  "private": true,
  "type": "module",
  "workspaces": [
    "condiviso",
    "api",
    "client"
  ],
  "scripts": {
    "api": "npm run dev --workspace @memodu/api",
    "client": "npm run tauri dev --workspace @memodu/client",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
